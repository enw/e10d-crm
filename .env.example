# App
AUTH_PASSWORD=changeme
AUTH_SECRET=replace-with-long-random-string

# Database (local dev — docker compose overrides host to `db`)
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
POSTGRES_PASSWORD=crm

# Google OAuth (T02+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match your dev server origin + /api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000

# Token encryption for Google OAuth tokens (T02+)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# LeadPure (T13+)
LEADPURE_API_KEY=

# Background sync cron (T16+)
CRON_SECRET=
